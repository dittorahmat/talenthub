{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "talenthub-api",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talenthub-db",
      "database_id": "3ae01831-0cd3-4093-a9f0-293aca5d70b5"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CV_STORAGE",
      "bucket_name": "talenthub-cvs"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "talenthub-cv-queue",
        "binding": "CV_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "talenthub-cv-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  }
}
